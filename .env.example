# Server-side configuration. Load secrets from scoped Infisical machine identities in production.
APP_MODE=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
LISTEN_ADDR=:8080
PUBLIC_URL=https://ops.example.com
OIDC_ISSUER=https://identity.example.com/realms/nocturn
OIDC_AUDIENCE=nocturn-api
OIDC_CLIENT_ID=nocturn-console
API_URL=http://127.0.0.1:8080
EMAIL_MODE=disabled
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
INFLUX_URL=
INFLUX_DATABASE=
INFLUX_TOKEN=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=
TURNSTILE_ACTION=contact
TRUSTED_PROXY_CIDRS=
